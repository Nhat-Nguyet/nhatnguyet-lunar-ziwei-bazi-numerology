{
  "name": "@nhatnguyet/le-hoi",
  "version": "0.2.0",
  "description": "Vietnamese festival and holiday calendar for JS/TS: 200 festivals (Tết, Hùng Kings, Mid-Autumn, temple and ethnic festivals) in Vietnamese, English and Chinese, with lunar to Gregorian dates for any year 1900 to 2100.",
  "license": "MIT",
  "author": "Nhat Nguyet (https://nhatnguyet.org)",
  "homepage": "https://nhatnguyet.org/en/ma-nguon-mo",
  "keywords": [
    "vietnamese festivals",
    "vietnam holidays",
    "vietnamese holidays",
    "public holidays",
    "lunar new year",
    "tet",
    "mid-autumn festival",
    "festival calendar",
    "lunar calendar",
    "cultural heritage",
    "open data",
    "le hoi",
    "lễ hội",
    "越南节日",
    "越南春节",
    "农历",
    "nhat nguyet",
    "vietnam",
    "vietnamese",
    "typescript",
    "zero dependencies"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "sinh": "node sinh-du-lieu.mjs",
    "build": "tsc -p tsconfig.json",
    "test": "node --conditions=source --test \"test/**/*.test.ts\""
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@nhatnguyet/am-lich": "^0.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nhat-Nguyet/nhatnguyet-lunar-ziwei-bazi-numerology.git",
    "directory": "js/packages/le-hoi"
  },
  "bugs": {
    "url": "https://github.com/Nhat-Nguyet/nhatnguyet-lunar-ziwei-bazi-numerology/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
