// ---------------------------------------------------------------------------
// Custom functions. Written by hand (src/functions.js); everything above this
// block is the bundled library, regenerated by `npm run build`.
//
// Every function takes one date or a whole range (=LUNARDATE(A2:A100)). A date can
// be a date cell, text "2027-02-06" or a date serial number. Optional arguments:
//   lang     "en" (default), "vi" or "zh"
//   country  "VN" (default, UTC+7), "CN", "KR", "JP", "TW"...
// ---------------------------------------------------------------------------

/**
 * Lunar date of a Gregorian date, as day/month/year.
 *
 * @param {Date|string|Array} date A date, a date range or text "YYYY-MM-DD".
 * @param {string} [lang] "en" (default), "vi" or "zh".
 * @param {string} [country] "VN" (default), "CN", "KR", "JP"...
 * @return The lunar date, e.g. 1/1/2027; a leap month is marked.
 * @customfunction
 */
function LUNARDATE(date, lang, country) {
  return eachCell_(date, function (iso) {
    var l = NhatNguyetLunar.toLunar(iso, calOpts_(lang, country));
    var leap = { vi: " (nhuận)", en: " (leap)", zh: "（闰）" }[l.lang] || "";
    return l.day + "/" + l.month + "/" + l.year + (l.leap ? leap : "");
  });
}

/**
 * Sexagenary name (Vietnamese: can chi) of the day, month or year of a date.
 *
 * @param {Date|string|Array} date A date, a date range or text "YYYY-MM-DD".
 * @param {string} [part] "day" (default), "month", "year" or "all".
 * @param {string} [lang] "en" (default), "vi" or "zh".
 * @param {string} [country] "VN" (default), "CN", "KR", "JP"...
 * @return The sexagenary name, e.g. Bing Chen.
 * @customfunction
 */
function SEXAGENARY(date, part, lang, country) {
  var p = String(part || "day").toLowerCase();
  if (["day", "month", "year", "all"].indexOf(p) < 0) throw new Error('part must be "day", "month", "year" or "all"');
  return eachCell_(date, function (iso) {
    var l = NhatNguyetLunar.toLunar(iso, calOpts_(lang, country));
    if (p === "all") return l.dayName + ", " + l.monthName + ", " + l.yearName;
    return l[p + "Name"];
  });
}

/**
 * Solar term (Vietnamese: tiết khí) in effect on a date: the last of the 24 terms that began on or before it.
 *
 * @param {Date|string|Array} date A date, a date range or text "YYYY-MM-DD".
 * @param {string} [lang] "en" (default), "vi" or "zh".
 * @param {string} [country] "VN" (default), "CN", "KR", "JP"...
 * @return The solar term, e.g. Start of Spring.
 * @customfunction
 */
function SOLARTERM(date, lang, country) {
  return eachCell_(date, function (iso) {
    return NhatNguyetLunar.solarTermOn(iso, calOpts_(lang, country)).current.name;
  });
}

/**
 * Gregorian date of a lunar date (for death anniversaries and festivals), as text YYYY-MM-DD.
 * Wrap it in DATEVALUE() to get a date cell.
 *
 * @param {number} year Lunar year.
 * @param {number} month Lunar month, 1 to 12.
 * @param {number} day Lunar day, 1 to 30.
 * @param {boolean} [leap] TRUE for the leap month.
 * @param {string} [country] "VN" (default), "CN", "KR", "JP"...
 * @return The Gregorian date, e.g. 2027-02-06.
 * @customfunction
 */
function SOLARDATE(year, month, day, leap, country) {
  var opts = country ? { country: String(country).toUpperCase() } : {};
  return NhatNguyetLunar.toSolar({ year: Number(year), month: Number(month), day: Number(day), leap: leap === true }, opts).date;
}

// --- helpers (a trailing underscore keeps them out of the formula list) ---

function calOpts_(lang, country) {
  var o = { lang: lang ? String(lang).toLowerCase() : "en" };
  if (country) o.country = String(country).toUpperCase();
  return o;
}

/** Applies fn to one value or to every cell of a range; empty cells stay empty. */
function eachCell_(value, fn) {
  if (Array.isArray(value)) {
    return value.map(function (row) {
      return Array.isArray(row) ? row.map(function (v) { return eachCell_(v, fn); }) : eachCell_(row, fn);
    });
  }
  if (value === "" || value === null || value === undefined) return "";
  return fn(isoDate_(value));
}

/** A cell value as "YYYY-MM-DD". Date cells are read in the spreadsheet's time zone. */
function isoDate_(v) {
  if (Object.prototype.toString.call(v) === "[object Date]") {
    if (typeof Utilities !== "undefined" && typeof SpreadsheetApp !== "undefined") {
      var tz;
      try { tz = SpreadsheetApp.getActiveSpreadsheet().getSpreadsheetTimeZone(); } catch (e) { tz = Session.getScriptTimeZone(); }
      return Utilities.formatDate(v, tz, "yyyy-MM-dd");
    }
    return v.getFullYear() + "-" + pad2_(v.getMonth() + 1) + "-" + pad2_(v.getDate());
  }
  if (typeof v === "number") {
    // Sheets date serial: days since 1899-12-30.
    var d = new Date(Date.UTC(1899, 11, 30) + Math.round(v) * 86400000);
    return d.getUTCFullYear() + "-" + pad2_(d.getUTCMonth() + 1) + "-" + pad2_(d.getUTCDate());
  }
  var p = NhatNguyetLunar.parseDate(String(v).trim());
  return p.year + "-" + pad2_(p.month) + "-" + pad2_(p.day);
}

function pad2_(n) {
  return (n < 10 ? "0" : "") + n;
}
